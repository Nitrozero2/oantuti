# OTTv2 Backend — Environment Variables
# Copy thành .env và điền giá trị thực

# ─── Judge0 ───────────────────────────────────────────────────────────────────
# Dùng khi backend chạy local (validate-agent endpoint)
# Khi deploy Vercel, backend không gọi Judge0 trực tiếp — Worker làm việc này
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_LANGUAGE_ID=71
JUDGE0_TIMEOUT_SECONDS=10
JUDGE0_MEMORY_LIMIT_KB=131072

# ─── Application ──────────────────────────────────────────────────────────────
MAX_MOVES_PER_MATCH=500
DEBUG=false

# CORS origins — production: chỉ domain frontend
# CORS_ORIGINS=["https://your-app.vercel.app"]
CORS_ORIGINS=["*"]

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Lấy từ: https://console.upstash.com → Database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ─── Worker Auth ──────────────────────────────────────────────────────────────
# Worker gửi header X-Worker-Secret với giá trị này
# Tạo bằng: openssl rand -hex 32
WORKER_SECRET=change-me-in-production

# ─── TTL (giây) ───────────────────────────────────────────────────────────────
JOB_TTL_SECONDS=3600
MATCH_TTL_SECONDS=86400
