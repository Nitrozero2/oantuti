# OTTv2 Tournament API - Environment Variables
# Copy file này thành .env và điền giá trị thực

# ─── Judge0 Configuration ─────────────────────────────────────────────────────
# URL của Judge0 instance (local Docker hoặc RapidAPI)
JUDGE0_URL=http://localhost:2358

# API key nếu dùng Judge0 trên RapidAPI hoặc self-hosted có auth
# Để trống nếu không cần
JUDGE0_API_KEY=

# Language ID cho Python 3 trên Judge0
# 71 = Python 3.x (mặc định trên Judge0 CE)
# Kiểm tra tại: http://localhost:2358/languages
JUDGE0_LANGUAGE_ID=71

# Timeout (giây) cho mỗi lần thực thi agent
JUDGE0_TIMEOUT_SECONDS=10

# Memory limit (KB) cho mỗi submission
# 131072 = 128 MB
JUDGE0_MEMORY_LIMIT_KB=131072

# ─── Application Configuration ───────────────────────────────────────────────
# Số nước tối đa mỗi trận (tránh loop vô hạn)
MAX_MOVES_PER_MATCH=500

# Debug mode (true/false)
DEBUG=false

# CORS origins (dấu phẩy phân cách)
# "*" = cho phép tất cả (development)
# Trong production: https://your-app.vercel.app
CORS_ORIGINS=["*"]
