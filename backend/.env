# OTTv2 Tournament API - Environment Variables

# ─── Judge0 Configuration ─────────────────────────────────────────────────────
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_LANGUAGE_ID=71
JUDGE0_TIMEOUT_SECONDS=10
JUDGE0_MEMORY_LIMIT_KB=131072

# ─── Application Configuration ───────────────────────────────────────────────
MAX_MOVES_PER_MATCH=500
DEBUG=false
CORS_ORIGINS=["*"]

# ─── Upstash Redis ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://factual-stingray-170088.upstash.io
UPSTASH_REDIS_REST_TOKEN=gQAAAAAAAphoAAIgcDFkZWVhOGJmOTljY2Q0Nzg1YTM5OWIwNDA3NTAyNWU2YQ

# ─── Worker Auth ──────────────────────────────────────────────────────────────
# Worker gửi header X-Worker-Secret với giá trị này
WORKER_SECRET=change-me-in-production

# ─── TTL ─────────────────────────────────────────────────────────────────────
JOB_TTL_SECONDS=3600
MATCH_TTL_SECONDS=86400
