# Copy this file to .env.local and fill in the values
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# OTTv2 FastAPI backend URL
# Dev local: http://localhost:8000
# Production: https://your-backend.vercel.app
BACKEND_URL=http://localhost:8000

# Must match WORKER_SECRET in backend/.env and worker/.env. It protects the
# internal endpoint that lets workers refill the continuous TrueSkill queue.
RATING_DISPATCH_SECRET=change-me-in-production
