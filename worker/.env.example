# Worker configuration
# Copy thành .env và điền giá trị thực

# URL của FastAPI (sau khi deploy lên Vercel)
BACKEND_URL=https://your-app.vercel.app

# Secret để xác thực với backend (phải khớp với WORKER_SECRET trong backend .env
# và RATING_DISPATCH_SECRET trong Frontend/.env.local)
WORKER_SECRET=change-me-in-production

# URL của Judge0 trên máy này
JUDGE0_URL=http://localhost:2358

# API key của Judge0 (để trống nếu không cần)
JUDGE0_API_KEY=

# ID duy nhất cho worker này (mặc định = hostname)
# WORKER_ID=my-host-01

# Số trận chạy đồng thời (mỗi slot = 1 trận đầy đủ, local engine)
# Judge0 default hỗ trợ ~4-8 concurrent submissions
MAX_CONCURRENT=4

# Giây giữa mỗi lần poll queue (khi cả hai queue đều rỗng)
POLL_INTERVAL=1

# Judge0 language ID (71 = Python 3)
JUDGE0_LANGUAGE_ID=71

# Timeout thực thi agent (giây)
JUDGE0_TIMEOUT_SECONDS=10

# Memory limit (KB)
JUDGE0_MEMORY_LIMIT_KB=131072

# ── Tournament ─────────────────────────────────────────────────────────────────

# Session ID tournament đang active (lấy từ DB sau khi admin tạo session)
# Worker sẽ poll tournament queue của session này.
# Để trống (hoặc 0) nếu chỉ chạy Friendly match.
TOURNAMENT_SESSION_ID=0

# URL của Next.js frontend để gửi callback kết quả trận đấu
FRONTEND_URL=http://localhost:3000
