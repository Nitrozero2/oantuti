# Worker configuration
# Copy thành .env và điền giá trị thực

# URL của FastAPI (sau khi deploy lên Vercel)
BACKEND_URL=http://localhost:8000

# Secret để xác thực với backend (phải khớp với WORKER_SECRET trong backend .env)
WORKER_SECRET=change-me-in-production

# URL của Judge0 trên máy này
JUDGE0_URL=http://localhost:2358

# API key của Judge0 (để trống nếu không cần)
JUDGE0_API_KEY=

# ID duy nhất cho worker này (mặc định = hostname)
# WORKER_ID=my-host-01

# Số job tối đa chạy đồng thời trên máy này
# Mỗi slot = 1 trận hoàn chỉnh (tournament hoặc friendly)
MAX_CONCURRENT=4

# Giây giữa mỗi lần poll queue (khi rỗng)
POLL_INTERVAL=1

# Judge0 language ID (71 = Python 3)
JUDGE0_LANGUAGE_ID=71

# Timeout thực thi agent (giây)
JUDGE0_TIMEOUT_SECONDS=10

# Memory limit (KB)
JUDGE0_MEMORY_LIMIT_KB=131072

# ── Tournament ─────────────────────────────────────────────────────────────────
# Session ID tournament đang active — xem trong DB hoặc trang Admin > Tournament
TOURNAMENT_SESSION_ID=0

# URL frontend để nhận callback kết quả
FRONTEND_URL=http://localhost:3000
