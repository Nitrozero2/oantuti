# OTTv2 Arena — Worker Environment Variables
# Copy file này thành .env và điền giá trị thực.
# CẢNH BÁO: Không commit file .env vào git.

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
# URL của FastAPI backend
BACKEND_URL=http://localhost:8000

# Worker → Backend auth: gửi qua header X-Worker-Secret khi claim/heartbeat
# Phải khớp với WORKER_SECRET trong backend/.env
WORKER_SECRET=tuanngth

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# URL của Next.js frontend để callback kết quả trận đấu
# QUAN TRỌNG: Chỉ domain gốc, không có đường dẫn con (ví dụ: https://oantuti.vercel.app)
FRONTEND_URL=http://localhost:3000

# Worker → Frontend auth: gửi qua header X-Worker-Callback-Secret khi callback
# Phải khớp với WORKER_CALLBACK_SECRET trong Frontend/.env.local
WORKER_CALLBACK_SECRET=tuanngth

# ── Judge0 ────────────────────────────────────────────────────────────────────
# URL của Judge0 chạy local trên máy này
JUDGE0_URL=http://localhost:2358

# API key của Judge0 (để trống nếu không cần)
JUDGE0_API_KEY=

# ── Worker settings ───────────────────────────────────────────────────────────
# ID duy nhất cho worker này (mặc định = hostname-uuid, không cần đặt thủ công)
# WORKER_ID=my-machine-01

# Số trận chạy song song tối đa trên máy này
MAX_CONCURRENT=4

# Giây giữa mỗi lần poll queue (khi queue rỗng)
POLL_INTERVAL=1

# ── Judge0 execution settings ─────────────────────────────────────────────────
# Language ID: 71 = Python 3
JUDGE0_LANGUAGE_ID=71

# Timeout thực thi agent (giây)
JUDGE0_TIMEOUT_SECONDS=10

# Memory limit (KB) — 128 MB
JUDGE0_MEMORY_LIMIT_KB=131072
